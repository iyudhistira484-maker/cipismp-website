{
  "name": "cipismp-store",
  "version": "1.0.0",
  "private": true,
  "description": "CipiSMP Store \u2014 webstore ranks & kits untuk server Minecraft CipiSMP",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "seed:owner": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "load": "k6 run tests/load/catalog-checkout.js"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource/silkscreen": "^5.2.6",
    "@noble/hashes": "1.8.0",
    "@radix-ui/react-accordion": "1.2.11",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.14",
    "@radix-ui/react-select": "2.2.5",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-switch": "1.2.5",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-tooltip": "1.2.7",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.44.7",
    "ioredis": "5.8.1",
    "lucide-react": "0.468.0",
    "next": "15.5.29",
    "nodemailer": "6.10.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.3",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "dotenv": "16.6.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "9.39.0",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
