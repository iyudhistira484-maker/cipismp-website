# ---------------------------------------------------------------------------
# CipiSMP Store — contoh konfigurasi. Salin ke .env lalu isi nilainya.
# Aplikasi menolak start bila variabel wajib kosong/tidak valid.
# ---------------------------------------------------------------------------

# Wajib -------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production                     # development | staging | production
APP_URL=https://cipismp.my.id          # URL publik (tanpa slash di akhir)
NEXT_PUBLIC_APP_URL=https://cipismp.my.id
# Untuk Docker Compose: user/database/password harus sama dengan POSTGRES_* di bawah.
# Untuk npm lokal, ubah host db menjadi localhost dan gunakan kredensial database lokal.
DATABASE_URL=postgresql://cipi:ganti_password@db:5432/cipismp
POSTGRES_USER=cipi
POSTGRES_DB=cipismp
POSTGRES_PASSWORD=                    # wajib diisi untuk Docker Compose; samakan dengan DATABASE_URL
# POSTGRES_BIND_ADDRESS=127.0.0.1     # jangan diekspos publik; default hanya host lokal
SESSION_SECRET=                       # >= 32 karakter acak: openssl rand -base64 48
ENCRYPTION_KEY=                       # base64 32 byte: openssl rand -base64 32

# Seeder (dipakai sekali untuk membuat Owner) -----------------------------
SEED_OWNER_EMAIL=owner@cipismp.my.id
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=                  # ganti setelah login pertama

# Email -------------------------------------------------------------------
EMAIL_PROVIDER=resend                 # resend | smtp | outbox (dev)
EMAIL_FROM="CipiSMP Store <no-reply@cipismp.my.id>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=0

# Pembayaran (boleh dikosongkan; isi lewat /admin/pengaturan) --------------
PAYMENT_DEFAULT_PROVIDER=TRIPAY       # TRIPAY | MIDTRANS | FAKE
TRIPAY_MODE=sandbox                   # sandbox | live
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
MIDTRANS_MODE=sandbox                 # sandbox | live
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
FAKE_PROVIDER_MODE=auto

# Login Discord (opsional) ------------------------------------------------
# Buat aplikasi di https://discord.com/developers/applications lalu tambahkan
# redirect URI: <APP_URL>/api/auth/discord/callback
# Tombol login Discord hanya muncul bila dua variabel ini terisi DAN fitur
# "Login Discord" dinyalakan di /admin/pengaturan.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Minecraft ---------------------------------------------------------------
# CipiSMP offline-mode: jangan gunakan untuk produksi sebelum dukungan UUID offline,
# LoginSecurity dan Floodgate selesai serta diuji di staging. mock hanya untuk dev/test.
MINECRAFT_LOOKUP_MODE=mojang          # UUID Mojang untuk server online-mode | mock untuk dev/test

# Pengiriman --------------------------------------------------------------
PLUGIN_SHARED_SECRET=                 # >= 16 karakter acak; sama dengan config shared-secret plugin
DELIVERY_RETRY_BASE_SECONDS=60

# Operasional -------------------------------------------------------------
REDIS_URL=                            # kosong = rate limiter in-memory
WORKER_ENABLED=1
WORKER_TICK_MS=5000
CRON_SECRET=                          # >= 16 karakter, untuk POST /api/cron
LOG_LEVEL=info
SENTRY_DSN=

# Bot protection (opsional) ----------------------------------------------
TURNSTILE_ENABLED=0
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Test/CI (opsional) ------------------------------------------------------
# Diisi hanya saat menjalankan `npm test` dengan database test.
# Tanpa variabel ini, test integrasi di-skip dan hanya unit test yang jalan.
TEST_DATABASE_URL=postgresql://cipismp:ganti_password@postgres:5432/cipismp_test
ARGON2_MEMORY_KIB=19456
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=168
SESSION_REMEMBER_DAYS=30
